# ============================================
# 線上打小人出氣筒 · 環境變數範本
# ============================================
# 一般使用不需要環境變數。RevenueCat Test Store 入口預設關閉，
# 只有本機測試時才設為 true；production 不可啟用。
#
# 如果你要在本機開發，直接複製此檔案為 .env.local 即可：
#   cp .env.example .env.local
# ============================================

NEXT_PUBLIC_ENABLE_RC_TEST_STORE=false
